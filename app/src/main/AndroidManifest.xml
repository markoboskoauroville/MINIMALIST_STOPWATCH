<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The microphone. It is asked for from the switch in the settings panel and never at launch,
      because an app that demands a microphone before it has shown you a stopwatch has not
      earned it. It is held only while the app is on screen AND the switch is on: there is no
      service, no foreground notification, and nothing listens when the stopwatch is not visible.
    -->
    <!--
      The only reason this app reaches the network: asking GitHub whether there is a newer
      release. The repository is public, so the request carries no token and nothing that could
      not be read over somebody's shoulder.

      Note what is NOT here: REQUEST_INSTALL_PACKAGES. An app that can install software without
      being asked again is a serious thing for a stopwatch to be, so the download URL is handed
      to Android and its own installer takes over, with its own dialogue and its own warnings.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Holding the microphone with the screen off needs a foreground service, and Android will not
      allow one of the microphone type without both of these. The notification permission is the
      price on Android 13 and later: the service must be announced, and announcing it requires
      permission to announce anything. Refusing it means voice commands work only while the app
      is on screen, which is the behaviour up to v22 and is not a crash.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility. From Android 11 an app cannot see which other apps exist unless it says
      what it is looking for, and SpeechRecognizer lives in another package. Without this,
      isRecognitionAvailable returns false on a phone that has a perfectly good recogniser.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Stopwatch">

        <!--
          configChanges: the activity handles rotation itself rather than being destroyed and
          rebuilt. The state would survive either way, because it is written to disk on every
          transition, but not being recreated means the digits do not blink at the moment the
          phone turns, and rotating is the one thing a person does WHILE watching the number.

          screenOrientation is not set here. It is set at run time from the lock button, and
          leaving it unset in the manifest means the app follows the phone until it is told not
          to, which is what "not locked" means.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          exported=false: nothing outside this app may start the microphone. foregroundServiceType
          declares to the system exactly what it is for, and Android enforces that the service
          does only that.
        -->
        <service
            android:name=".ListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
